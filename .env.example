# Gateway environment reference for a standalone deployment or another harness.
#
# This file is NOT the JiuwenSwarm .env template. JiuwenSwarm deployments use
# JiuwenSwarm's own .env.template and launcher; do not copy this file for a
# JiuwenSwarm deployment.
#
# Every entry below has a built-in default, so nothing here is required.
# To make these values effective for Gateway:
#   - copy this file to <data root>/config/.env
#     (default ~/.jiuwenswarm/config/.env), or
#   - start Gateway with --dotenv <path>, or
#   - export the variables in the process environment.
#
# For the personal edition the .env location follows AGENT_GATEWAY_DATA_DIR /
# AGENT_GATEWAY_HOME; it does not follow AGENT_GATEWAY_CONFIG_DIR.
# AgentOS deployments load <workspace>/config/.env, shared with the AgentServer.

# ---------------------------------------------------------------------------
# Downstream AgentServer (WebSocket). AGENT_SERVER_URL wins over host + port.
# ---------------------------------------------------------------------------
# AGENT_SERVER_URL=ws://127.0.0.1:18092
# AGENT_SERVER_HOST=127.0.0.1
# AGENT_SERVER_PORT=18092

# ---------------------------------------------------------------------------
# Data root and Gateway config directory.
#
# The default data root is ~/.jiuwenswarm, which lives under AGENT_GATEWAY_HOME
# (default: the user home). AGENT_GATEWAY_DATA_DIR sets the data root directly
# and wins over AGENT_GATEWAY_HOME. When Gateway runs next to another harness,
# set AGENT_GATEWAY_DATA_DIR explicitly so the two keep separate directories.
# The directory passed to AGENT_GATEWAY_CONFIG_DIR holds config-gateway.yaml;
# it must be set before the process starts.
# ---------------------------------------------------------------------------
# AGENT_GATEWAY_HOME=/srv/agent-gateway-home
# AGENT_GATEWAY_DATA_DIR=/srv/agent-gateway
# AGENT_GATEWAY_CONFIG_DIR=/srv/agent-gateway/config

# ---------------------------------------------------------------------------
# Listeners.
# ---------------------------------------------------------------------------
# WEB_HOST=127.0.0.1
# WEB_PORT=19000
# WEB_PATH=/ws
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=19001

# ---------------------------------------------------------------------------
# Reconnect to AgentServer at startup.
# ---------------------------------------------------------------------------
# AGENT_CONNECT_RETRY=20
# AGENT_CONNECT_RETRY_INTERVAL=3

# ---------------------------------------------------------------------------
# Security and ingress checks.
#
# AGENT_GATEWAY_SSL_VERIFY is the TLS verification switch for outbound
# requests. Origin checks are off by default; set the switch to 1 to enable
# them and list allowed host names separated by commas.
# ---------------------------------------------------------------------------
# AGENT_GATEWAY_SSL_VERIFY=true
# AGENT_GATEWAY_ENABLE_ORIGIN_CHECK=0
# AGENT_GATEWAY_WS_ALLOWED_ORIGIN_HOSTS=127.0.0.1,localhost

# ---------------------------------------------------------------------------
# Request extension forwarding: comma-separated HTTP header names copied into
# the request ext passed downstream.
# ---------------------------------------------------------------------------
# AGENT_GATEWAY_REQUEST_EXT_FORWARD_HEADERS=

# ---------------------------------------------------------------------------
# Debugging: emit sample log lines after log-masking rules reload.
# ---------------------------------------------------------------------------
# AGENT_GATEWAY_LOG_MASKING_PROBE=0
